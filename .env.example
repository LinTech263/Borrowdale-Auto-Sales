# VITE_GEMINI_API_KEY: Required for the AI description drafting feature.
# In Vite, client-side env vars MUST be prefixed with VITE_ to be exposed to the browser.
# Set this in Vercel Dashboard → Project → Settings → Environment Variables.
VITE_GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: The URL where this app is hosted (used for SEO canonical links etc.)
APP_URL="https://borrowdaleautosales.co.zw"
